import numpy as np
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score
from scipy.stats import pearsonr

def calculate_metrics(y_true, y_pred):
    """
    Evaluation metrics for MultiFuseNet logging generation task
    Paper official metrics: MSE, MAE, R², Pearson Correlation Coefficient
    Extended additional metric: CCC (Concordance Correlation Coefficient)
    Args:
        y_true: 2D array [n_samples, n_curves]
        y_pred: 2D array [n_samples, n_curves]
    Returns:
        dict: averaged metrics across all logging curves
    """
    # input sanity check
    if y_true.shape != y_pred.shape:
        raise ValueError(f"Shape mismatch y_true{y_true.shape} vs y_pred{y_pred.shape}")
    n_samples, n_curves = y_true.shape
    metrics = {}

    # ========== Paper original metrics ==========
    mse_list, mae_list, r2_list, pearson_list = [], [], [], []
    for i in range(n_curves):
        yt = y_true[:, i]
        yp = y_pred[:, i]

        mse = mean_squared_error(yt, yp)
        mae = mean_absolute_error(yt, yp)
        r2 = r2_score(yt, yp)

        # pearson nan safe: constant value will return nan
        corr, _ = pearsonr(yt, yp)
        if not np.isfinite(corr):
            corr = np.nan

        mse_list.append(mse)
        mae_list.append(mae)
        r2_list.append(r2)
        pearson_list.append(corr)

    metrics["MSE"] = np.mean(mse_list)
    metrics["MAE"] = np.mean(mae_list)
    metrics["R²"] = np.mean(r2_list)
    metrics["Pearson"] = np.nanmean(pearson_list)

    # ========== Extended additional metric (not reported in paper) ==========
    ccc_list = []
    for i in range(n_curves):
        yt = y_true[:, i]
        yp = y_pred[:, i]
        mean_true = np.mean(yt)
        mean_pred = np.mean(yp)
        var_true = np.var(yt, ddof=0)
        var_pred = np.var(yp, ddof=0)
        covar = np.cov(yt, yp, ddof=0)[0, 1]
        denom = var_true + var_pred + (mean_true - mean_pred) ** 2
        if denom < 1e-12:
            ccc = np.nan
        else:
            ccc = (2 * covar) / denom
        ccc_list.append(ccc)
    metrics["CCC"] = np.nanmean(ccc_list)

    return metrics
